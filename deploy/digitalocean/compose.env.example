# Use with docker compose --env-file /etc/employee-hub/compose.env. Keep the
# file mode 0600 and use distinct, URL-safe random secrets for each password.
API_IMAGE_TAG=codex-digitalocean-migration
C9_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
C9_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
C9_POSTGRES_CERT=/etc/employee-hub/tls/c9/server.crt
C9_POSTGRES_KEY=/etc/employee-hub/tls/c9/server.key
C6_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
C6_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
C6_POSTGRES_CERT=/etc/employee-hub/tls/c6/server.crt
C6_POSTGRES_KEY=/etc/employee-hub/tls/c6/server.key
