[Unit]
Description=Employee Hub C6 tenant API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=employee-hub-c6
Group=employee-hub-c6
WorkingDirectory=/opt/employee-hub/app
EnvironmentFile=/etc/employee-hub/c6.env
ExecStart=/usr/bin/node /opt/employee-hub/app/artifacts/api-server/dist/index.mjs
Restart=on-failure
RestartSec=5s
UMask=0077
StateDirectory=employee-hub/c6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/employee-hub/c6

[Install]
WantedBy=multi-user.target
