// Cloudflare Worker that serves the C9/C6 hub static builds and proxies /api
// to the matching DigitalOcean API. The deploy workflows override the Worker
// name and tenant-specific DO_API_ORIGIN.
{
  "name": "c6",
  "main": "./artifacts/engagement-hub/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./artifacts/engagement-hub/dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    // Client-side routes like /challenges/123 fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
